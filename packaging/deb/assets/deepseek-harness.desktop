[Desktop Entry]
Type=Application
Version=1.0
Name=DeepSeek Harness
Name[zh_CN]=DeepSeek Harness 工作台
GenericName=AI Coding Agent
GenericName[zh_CN]=AI 编程助手
Comment=Start the local DeepSeek Harness Web UI
Comment[zh_CN]=启动本地 DeepSeek Harness Web 工作台
Exec=/usr/bin/dsh-launch
TryExec=/usr/bin/dsh-launch
Icon=deepseek-harness
Terminal=false
Categories=Development;
Keywords=AI;agent;deepseek;coding;
StartupNotify=true
Actions=Stop;

[Desktop Action Stop]
Name=Stop Web Service
Name[zh_CN]=停止 Web 服务
Exec=/usr/bin/dsh-launch --stop
