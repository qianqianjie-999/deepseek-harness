#!/bin/sh
# Stop background Web UI instances before the package files disappear.
set -e
for pidfile in /root/.dsh/web.pid /home/*/.dsh/web.pid; do
  [ -f "$pidfile" ] || continue
  pid=$(cat "$pidfile" 2>/dev/null || true)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
done
exit 0
